            </div>
        </div>

        <!-- Col 2 -->
        <div class="card">
            <div>
                <div class="card-header">
                    <div class="card-title">Solvencia Registrada</div>
                </div>
                <div class="metric-box" style="border-color: #38bdf8;">
                    <div class="metric-value" style="color: #38bdf8;">$74,9M</div>
                    <div class="metric-label">Capacidad Económica ROPIC[cite: 4]</div>
                </div>
                <div class="metric-box" style="border-color: #f59e0b;">
