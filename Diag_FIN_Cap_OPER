    </header>

    <div class="grid-3">
        <!-- Col 1 -->
        <div class="card">
            <div>
                <div class="card-header">
                    <div class="card-title">Rentabilidad Real</div>
                </div>
                <div class="metric-box">
                    <div class="metric-value">48%</div>
                    <div class="metric-label">Margen Operativo Real[cite: 4]</div>
